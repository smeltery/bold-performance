{
  "name": "bold-performance",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "astro build && bun scripts/discovery.ts && bun scripts/crawl.ts",
    "preview": "astro preview --host 0.0.0.0",
    "format": "prettier --write .",
    "check": "prettier --check . && markdownlint-cli2 && bun scripts/validate.ts && astro check && bun test && bun run build",
    "hooks": "git config core.hooksPath .githooks",
    "og": "bun scripts/generate-og.ts"
  },
  "dependencies": {
    "@astrojs/react": "7.0.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "^3.9.11",
    "astro": "7.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@resvg/resvg-js": "^2.6.2",
    "@types/bun": "1.3.11",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/turndown": "^5.0.6",
    "happy-dom": "20.14.6",
    "markdownlint-cli2": "0.18.1",
    "mermaid": "12.1.0",
    "prettier": "3.6.2",
    "prettier-plugin-astro": "1.1.1",
    "turndown": "^7.2.4",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": "24.x"
  }
}
