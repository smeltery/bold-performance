---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/footer.css";
import "../styles/base.css";
import "../styles/chrome.css";
import "../styles/hero.css";
import "../styles/sections.css";
import "../styles/conversion.css";
import "../styles/responsive.css";
const {
  title = "Bold Performance | Personal Training with Brock Jones",
  description = "Build strength that lasts. Personalized one-on-one coaching with Brock Jones, former pro athlete and NASM-certified trainer in Scottsdale, Arizona.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#161c1d" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/assets/logo.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>
  <body>
    <a class="skip" href="#main">
      Skip to content
    </a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
