---
import PageDetails from "../components/PageDetails.astro";
import Layout from "../layouts/Layout.astro";
import PageIntro from "../components/PageIntro.astro";
import Coach from "../components/Coach.astro";
---

<Layout
  title="Meet Brock Jones | Bold Performance"
  description="Meet Brock Jones: former Diamondbacks organization pitcher, NASM-certified personal trainer, and coach in Scottsdale."
>
  <PageIntro
    eyebrow="MEET BROCK JONES"
    title="Experience earned."
    accent="Purpose shared."
    description="From professional baseball to personal coaching, Brock’s work is grounded in discipline, resilience, and helping people move forward."
  />
  <Coach />
  <section class="section story">
    <p class="eyebrow">THE PERSON BEHIND THE PROGRAM</p>
    <h2>
      Strength is built
      <br />
      one day at a time.
    </h2>
    <div>
      <p>
        Brock developed his game at W.F. West High School in Washington before
        being drafted by Arizona in 2019. Five years in the Diamondbacks
        organization gave him firsthand experience of professional training and
        the work behind a return to competition.
      </p>
      <p>
        Now a NASM-certified trainer and MDM Pitching Performance assistant
        coach, he brings that perspective to athletes and personal training
        clients. His faith is a foundation for the purpose he brings to his
        work.
      </p>
      <a class="button" href="/contact">
        Start a conversation with Brock
      </a>
    </div>
  </section>
  <PageDetails page="about" />
</Layout>
<style>
  .story {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 30px 8vw;
  }
  .story > .eyebrow {
    grid-column: 1/-1;
  }
  .story p:not(.eyebrow) {
    font-size: 14px;
    color: var(--muted);
  }
  @media (max-width: 700px) {
    .story {
      grid-template-columns: 1fr;
    }
  }
</style>
