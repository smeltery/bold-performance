---
import PageDetails from "../components/PageDetails.astro";
import Layout from "../layouts/Layout.astro";
import CareerMarks from "../components/CareerMarks.astro";
import Icon from "../components/Icon";
import Faq from "../components/Faq.astro";
import Coach from "../components/Coach.astro";
import Coaching from "../components/Coaching.astro";
import Approach from "../components/Approach.astro";
---

<Layout>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">
        <Icon name="cactus" size={16} /> PERSONAL TRAINING · SCOTTSDALE, AZ
      </p>
      <h1>
        Built for more.
        <br />
        Trained for <em>life.</em>
      </h1>
      <p class="hero-description">
        Get stronger. Move better. Become the version of yourself you know is
        possible—with personalized coaching from Brock Jones.
      </p>
      <a class="button" href="/contact">
        <Icon name="dumbbell" /> Start your journey
      </a>
      <a class="text-link" href="#coaching">
        Find your focus
      </a>
      <div class="hero-credentials">
        <span>
          <strong>Former pro athlete</strong>Professional playing experience
        </span>
        <span>
          <strong>NASM certified</strong>Coaching with a foundation
        </span>
      </div>
      <CareerMarks />
    </div>
    <div class="hero-image">
      <img
        src="/assets/training.jpg"
        alt="Barbells and strength training equipment in a gym"
        width="1400"
        height="1100"
        fetchpriority="high"
      />
      <span class="image-label">PURPOSE IN EVERY REP.</span>
      <div class="image-caption">
        <span>
          THE WORK IS YOURS.
          <br />
          THE PLAN? WE BUILD IT TOGETHER.
        </span>
        <img
          class="hero-brand-mark"
          src="/assets/mark-dark.svg"
          alt=""
          width="70"
          height="48"
        />
      </div>
    </div>
  </section>
  <div class="principles">
    <span>PERSONALIZED COACHING</span>
    <i>✳</i>
    <span>INTENTIONAL MOVEMENT</span>
    <i>✳</i>
    <span>LASTING STRENGTH</span>
    <i>✳</i>
    <span>REAL ACCOUNTABILITY</span>
  </div>
  <Coaching />
  <Coach />
  <Approach />
  <PageDetails page="home" />
  <Faq />
  <section id="contact" class="section contact">
    <div>
      <p class="eyebrow">YOUR GOALS DESERVE A PLAN</p>
      <h2>
        Let’s build
        <br />
        <em>your next step.</em>
      </h2>
      <p class="contact-lead">
        Stronger for your sport. More confident in the gym. More consistent in
        everyday life. Tell Brock what matters to you, and start a conversation
        about training that fits.
      </p>
      <a class="button light" href="/contact">
        <Icon name="message" /> Start my training introduction
      </a>
      <p class="contact-reassurance">
        About 3–5 minutes · No booking or payment required
      </p>
    </div>
    <aside class="contact-preview" aria-label="What to expect">
      <p class="eyebrow">A SIMPLE FIRST STEP</p>
      <h3>
        You bring the goals.
        <br />
        Let’s get specific.
      </h3>
      <ol>
        <li>
          <strong>Tell Brock where you want to go.</strong>
          <span>
            Share your goals, training experience, and the coaching you’re
            looking for.
          </span>
        </li>
        <li>
          <strong>Make room for your real life.</strong>
          <span>
            Add your schedule, preferred training focus, and any questions you
            want to discuss.
          </span>
        </li>
        <li>
          <strong>Start the conversation.</strong>
          <span>
            Send your introduction, then discuss availability, location, and
            pricing directly with Brock.
          </span>
        </li>
      </ol>
      <p class="contact-location">
        <Icon name="cactus" size={16} /> Personalized coaching · Scottsdale, AZ
      </p>
    </aside>
  </section>
</Layout>
