---
import Icon, { type IconName } from "./Icon";
const links: { href: string; label: string; detail: string; icon: IconName }[] =
  [
    {
      href: "/coaching",
      label: "Coaching",
      detail: "Find your training focus",
      icon: "dumbbell",
    },
    {
      href: "/about",
      label: "Meet Brock",
      detail: "Experience behind the coaching",
      icon: "user",
    },
    {
      href: "/approach",
      label: "The approach",
      detail: "A plan with purpose",
      icon: "check",
    },
    {
      href: "/tools",
      label: "Training tools",
      detail: "Plan, load, and time your session",
      icon: "timer",
    },
  ];
---

<header id="top">
  <a class="brand" href="/" aria-label="Bold Performance home">
    <img src="/assets/logo.svg" alt="" width="86" height="44" />
    <img
      class="wordmark"
      src="/assets/wordmark.svg"
      alt=""
      width="115"
      height="42"
    />
  </a>
  <nav aria-label="Main navigation">
    {links.map((link) => (
      <a
        href={link.href}
        aria-current={Astro.url.pathname === link.href ? "page" : undefined}
      >
        {link.label}
      </a>
    ))}
  </nav>
  <div class="header-actions">
    <button
      class="search-trigger desktop-search"
      data-open-search
      aria-label="Search pages and tools"
      aria-keyshortcuts="Meta+K Control+K"
    >
      <Icon name="search" size={18} />
      <span>Search</span>
    </button>
    <a class="button small desktop-cta" href="/contact">
      <Icon name="message" /> Let’s get to work
    </a>
  </div>
  <button
    class="menu-toggle"
    aria-expanded="false"
    aria-controls="mobile-nav"
    aria-haspopup="dialog"
  >
    <Icon name="menu" /> Menu
  </button>
</header>
<dialog id="mobile-nav" aria-label="Main menu">
  <div class="menu-heading">
    <span class="eyebrow">BOLD PERFORMANCE</span>
    <button class="menu-close" aria-label="Close menu" autofocus>
      <Icon name="close" />
    </button>
  </div>
  <button class="mobile-search" data-open-search>
    <Icon name="search" /> Search pages and tools
  </button>
  <p class="menu-intro">
    Your next step.
    <br />
    <em>Make it count.</em>
  </p>
  <nav aria-label="Mobile navigation">
    {links.map((link) => (
      <a href={link.href}>
        <span class="menu-icon">
          <Icon name={link.icon} />
        </span>
        <span>
          {link.label}
          <small>{link.detail}</small>
        </span>
      </a>
    ))}
  </nav>
  <div class="menu-contact">
    <a class="button" href="/contact">
      <Icon name="message" /> Talk training with Brock
    </a>
    <p>
      <Icon name="location" size={15} /> Scottsdale, Arizona
    </p>
  </div>
</dialog>
<script>
  const button = document.querySelector<HTMLButtonElement>(".menu-toggle")!;
  const menu = document.querySelector<HTMLDialogElement>("#mobile-nav")!;
  function close() {
    menu.close();
  }
  button.addEventListener("click", () => {
    menu.showModal();
    button.setAttribute("aria-expanded", "true");
    document.body.style.overflow = "hidden";
  });
  menu.addEventListener("close", () => {
    button.setAttribute("aria-expanded", "false");
    document.body.style.overflow = "";
    button.focus();
  });
  menu.querySelector(".menu-close")!.addEventListener("click", close);
  menu
    .querySelectorAll("a")
    .forEach((link) => link.addEventListener("click", close));
  menu.addEventListener("click", (event) => {
    if (event.target === menu) {
      const bounds = menu.getBoundingClientRect();
      if (event.clientX < bounds.left || event.clientX > bounds.right) close();
    }
  });
  matchMedia("(min-width: 901px)").addEventListener("change", (event) => {
    if (event.matches && menu.open) close();
  });
</script>
