---
import Icon from "./Icon";
import { catalog } from "../tools/catalog";
const pages = [
  ["Home", "/", "Personalized training in Scottsdale"],
  ["Coaching", "/coaching", "Strength, movement, and performance"],
  ["Meet Brock", "/about", "Professional experience and personal coaching"],
  ["The approach", "/approach", "What working together looks like"],
  ["Training tools", "/tools", "Search every fitness and nutrition tool"],
  ["Start a conversation", "/contact", "Tell Brock about your goals"],
];
const entries = [
  ...pages.map(([title, href, description]) => ({
    title,
    href,
    description,
    group: href === "/contact" ? "Contact" : "Pages",
  })),
  ...catalog.map((tool) => ({
    title: tool.title,
    href: `/tools/${tool.slug}`,
    description: `${tool.category} · ${tool.description}`,
    group: "Tools",
  })),
];
const groups = ["Pages", "Tools", "Contact"];
---

<dialog id="site-search" aria-labelledby="search-title">
  <div class="search-heading">
    <div>
      <img src="/assets/logo.svg" alt="" width="60" height="30" />
      <h2 id="search-title">Find your next step.</h2>
    </div>
    <button class="menu-close" data-close-search aria-label="Close search">
      <Icon name="close" />
    </button>
  </div>
  <label class="search-input">
    <Icon name="search" />
    <span class="sr-only">Search pages and tools</span>
    <input
      type="search"
      id="search-query"
      placeholder="Search training, nutrition, coaching…"
      autocomplete="off"
      aria-controls="search-results"
    />
  </label>
  <div class="search-filters" role="group" aria-label="Filter search results">
    {["All", ...groups].map((group) => (
      <button
        type="button"
        data-search-filter={group}
        aria-pressed={group === "All"}
        aria-controls="search-results"
      >
        {group}
      </button>
    ))}
  </div>
  <div class="search-results" id="search-results">
    {groups.map((group) => (
      <section
        data-search-section={group}
        aria-labelledby={`search-${group.toLowerCase()}`}
      >
        <h3 id={`search-${group.toLowerCase()}`}>{group}</h3>
        {entries
          .filter((entry) => entry.group === group)
          .map((entry) => (
            <a
              href={entry.href}
              data-group={group}
              data-search={`${entry.title} ${entry.description} ${group}`.toLowerCase()}
            >
              <Icon
                name={
                  group === "Pages"
                    ? "activity"
                    : group === "Tools"
                      ? "timer"
                      : "message"
                }
                size={18}
              />
              <span>
                <strong>{entry.title}</strong>
                <small>
                  {entry.description.includes("Scottsdale") && (
                    <Icon name="cactus" size={14} />
                  )}{" "}
                  {entry.description}
                </small>
              </span>
            </a>
          ))}
      </section>
    ))}
  </div>
  <p class="search-empty" hidden>
    No results. Try “protein,” “strength,” or “contact.”
  </p>
  <div class="search-footer">
    <span role="status"></span>
    <span>
      <kbd>↑</kbd>
      <kbd>↓</kbd> Navigate <kbd>↵</kbd> Open <kbd>Esc</kbd> Close
    </span>
  </div>
</dialog>
<script>
  import "../client/search";
</script>
