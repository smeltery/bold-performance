<section class="section faq">
  <div>
    <p class="eyebrow">A LITTLE CLARITY</p>
    <h2>
      Before your
      <br />
      first rep.
    </h2>
  </div>
  <div>
    {[
      [
        "Do I need training experience?",
        "You don’t need an athletic background to start the conversation. Tell Brock about your experience and goals so you can discuss the right starting point.",
      ],
      [
        "Where does training take place?",
        "Bold Performance is based in Scottsdale, Arizona. Contact Brock to discuss current training locations and scheduling.",
      ],
      [
        "What does coaching cost?",
        "Reach out to Brock for current pricing and availability. You’ll be able to discuss your goals and options before committing.",
      ],
      [
        "How do I get started?",
        "Start with the training introduction on our contact page. Share your goals, experience, preferred coaching, and availability so Brock has the context to discuss your next step.",
      ],
    ].map(([question, answer]) => (
      <details>
        <summary>
          {question}
          <span>+</span>
        </summary>
        <p>{answer}</p>
        {question === "How do I get started?" && (
          <p>
            <a class="text-link" href="/contact">
              Tell Brock about your training goals
            </a>
          </p>
        )}
      </details>
    ))}
  </div>
</section>
