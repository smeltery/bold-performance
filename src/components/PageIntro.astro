---
const { eyebrow, title, accent, description } = Astro.props;
---

<section class="section page-heading">
  <div>
    <p class="eyebrow">{eyebrow}</p>
    <h1>
      {title}
      <br />
      <em>{accent}</em>
    </h1>
    <p>{description}</p>
  </div>
  <img
    src="/assets/logo-with-text.svg"
    width="210"
    height="182"
    alt="Bold Performance"
  />
</section>
<style>
  .page-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 45px;
    padding-bottom: 65px;
  }
  .page-heading h1 {
    font-size: clamp(54px, 6vw, 90px);
    margin-bottom: 24px;
  }
  .page-heading p:last-child {
    max-width: 580px;
    font-size: 15px;
    color: var(--muted);
  }
  .page-heading > img {
    background: #fff;
    padding: 18px;
    width: 210px;
    height: auto;
  }
  @media (max-width: 800px) {
    .page-heading {
      padding-bottom: 40px;
    }
    .page-heading > img {
      display: none;
    }
  }
</style>
